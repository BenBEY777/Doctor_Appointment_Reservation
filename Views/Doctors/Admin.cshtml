@model IEnumerable<DocTest.Models.Doctor>

@{
    ViewData["Title"] = "Index";
}

<head>
<link rel="stylesheet" href="~/css/DoctorsAdmin.css" asp-append-version="true" />
</head>

<h1>Специалисти</h1>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Specialty)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoneNumber)
            </th>
            <th>
                Действия
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Specialty)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>  
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Редактирай</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Детайли</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>
