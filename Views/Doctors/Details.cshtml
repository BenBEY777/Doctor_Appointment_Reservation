@model DocTest.Models.Doctor

@{
    ViewData["Title"] = "Details";
}

<h1>Детайли</h1>
<head>
    <link rel="stylesheet" href="~/css/DoctorsDetails.css" asp-append-version="true" />
</head>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Specialty)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Specialty)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PhoneNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PhoneNumber)
        </dd>
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-save">Редактирай</a>
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </dl>
</div>
